{
  "name": "cs2-portfolio-tracker",
  "version": "1.0.0",
  "description": "CS2 portfolio tracker that pulls inventory (including Storage Units) from the Game Coordinator and values it on CSFloat.",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "cli": "tsx src/index.ts --cli",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "pack:win": "npm run build && node scripts/pack-win.mjs",
    "set-price": "tsx src/index.ts --set-price"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cs2",
    "counter-strike",
    "steam",
    "csfloat",
    "portfolio"
  ],
  "license": "MIT",
  "pkg": {
    "scripts": [
      "node_modules/lzma/src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      ".env.example",
      "node_modules/cs2-inventory-resolver/data/**/*",
      "node_modules/@doctormckay/steam-crypto/**/*",
      "node_modules/lzma/src/**/*"
    ],
    "outputPath": "release",
    "sea": true
  },
  "dependencies": {
    "axios": "^1.11.0",
    "chalk": "^5.5.0",
    "cli-table3": "^0.6.5",
    "cs2-inventory-resolver": "^0.4.25",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "node-cs2": "^2.3.1",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@yao-pkg/pkg": "^6.19.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
