# Place this file next to CS2InventoryTracker.exe, or in the project root if you run from source.
# Steam login (required unless you use --offline)
STEAM_ACCOUNT_NAME=your_steam_username
# Wrap the password in double quotes if it contains #, $, spaces, or other special characters.
STEAM_PASSWORD="your_steam_password"

# Optional: Steam Guard mobile shared secret (auto-fills 2FA codes)
# STEAM_SHARED_SECRET=

# Optional: CSFloat developer API key (recommended; some listing filters need it)
# Create one at https://csfloat.com/profile under the Developer tab
# CSFLOAT_API_KEY=

# Optional: web UI port. Default 3000.
# PORT=3000
